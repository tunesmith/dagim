# dagim v1

node gumbo-pot-combine-butter-white-rice-flour: In gumbo pot, combine 1/2 cup butter and 1/2 cup white rice flour

node prepare-rice-cooker-press-start: Prepare rice in rice cooker and press start

node put-hot-water-chicken-pot: Put two quarts of hot water in the chicken pot
  parent gumbo-pot-combine-butter-white-rice-flour  # In gumbo pot, combine 1/2 cup butter and 1/2 cup white rice...

node put-chicken-thighs-pot: Put two pounds of chicken thighs in the chicken pot
  parent gumbo-pot-combine-butter-white-rice-flour  # In gumbo pot, combine 1/2 cup butter and 1/2 cup white rice...

node cook-medium-heat-stirring-dark-brown-roux: Cook over medium heat, frequently stirring to make a dark brown roux, about 15 minutes
  parent gumbo-pot-combine-butter-white-rice-flour  # In gumbo pot, combine 1/2 cup butter and 1/2 cup white rice...

node slice-andouille-sausage: Slice 12 ounces Andouille sausage
  parent put-hot-water-chicken-pot  # Put two quarts of hot water in the chicken pot
  parent put-chicken-thighs-pot  # Put two pounds of chicken thighs in the chicken pot

node bring-water-to-boil: Bring water to boil
  parent put-hot-water-chicken-pot  # Put two quarts of hot water in the chicken pot
  parent put-chicken-thighs-pot  # Put two pounds of chicken thighs in the chicken pot

node add-veggies-gumbo-pot-saute-until-tender: Add veggies to gumbo pot and saute until tender, about 8-10 minutes
  parent cook-medium-heat-stirring-dark-brown-roux  # Cook over medium heat, frequently stirring to make a dark...
  parent give-veggie-bowl-curt  # Set veggie bowl next to gumbo pot

node give-veggie-bowl-curt: Set veggie bowl next to gumbo pot
  parent dice-celery-veggie-bowl  # Dice 1/3 cup celery into veggie bowl
  parent mince-2-cloves-garlic-veggie-bowl  # Mince 2 cloves garlic into veggie bowl
  parent dice-green-red-bell-pepper-veggie-bowl  # Dice 1.5 cups green/red bell pepper into veggie bowl
  parent dice-yellow-onion-veggie-bowl  # Dice 1.5 cups yellow onion into veggie bowl

node dice-celery-veggie-bowl: Dice 1/3 cup celery into veggie bowl
  parent prepare-rice-cooker-press-start  # Prepare rice in rice cooker and press start

node mince-2-cloves-garlic-veggie-bowl: Mince 2 cloves garlic into veggie bowl
  parent prepare-rice-cooker-press-start  # Prepare rice in rice cooker and press start

node dice-green-red-bell-pepper-veggie-bowl: Dice 1.5 cups green/red bell pepper into veggie bowl
  parent prepare-rice-cooker-press-start  # Prepare rice in rice cooker and press start

node dice-yellow-onion-veggie-bowl: Dice 1.5 cups yellow onion into veggie bowl
  parent prepare-rice-cooker-press-start  # Prepare rice in rice cooker and press start

node saute-sliced-sausage-until-lightly-browned: Saute sliced sausage until lightly browned
  parent slice-andouille-sausage  # Slice 12 ounces Andouille sausage

node simmer-chicken-until-fully-cooked: Simmer chicken until fully cooked, 20-25 minutes
  parent bring-water-to-boil  # Bring water to boil

node drain-2-cans-total-diced-canned-tomatoes-give: Drain 2 cans (28 oz total) diced canned tomatoes
  parent give-veggie-bowl-curt  # Set veggie bowl next to gumbo pot

node add-tomatoes-sausage-gumbo-pot: Add tomatoes and sausage to gumbo pot
  parent add-veggies-gumbo-pot-saute-until-tender  # Add veggies to gumbo pot and saute until tender, about 8-10...
  parent saute-sliced-sausage-until-lightly-browned  # Saute sliced sausage until lightly browned
  parent drain-2-cans-total-diced-canned-tomatoes-give  # Drain 2 cans (28 oz total) diced canned tomatoes

node cook-for-stirring-occasionally: Cook for 10 minutes, stirring occasionally.
  parent add-tomatoes-sausage-gumbo-pot  # Add tomatoes and sausage to gumbo pot

node add-contents-spice-bowl-gumbo-pot: Add contents of spice bowl to gumbo pot
  parent cook-for-stirring-occasionally  # Cook for 10 minutes, stirring occasionally.
  parent set-spice-bowl-next-gumbo-pot  # Set spice bowl next to gumbo pot

node add-reserved-chicken-water-gumbo-pot-simmer-loosely: Add 4 cups of reserved chicken water to gumbo pot and simmer for 30 minutes loosely covered, stirring occasionally
  parent add-contents-spice-bowl-gumbo-pot  # Add contents of spice bowl to gumbo pot
  parent remove-chicken-reserve-water  # Remove chicken and RESERVE WATER

node add-chicken: Add chicken
  parent add-reserved-chicken-water-gumbo-pot-simmer-loosely  # Add 4 cups of reserved chicken water to gumbo pot and simmer...
  parent shred-cut-chicken-small-pieces-give-curt  # Shred or cut chicken into small pieces

node simmer-an-additional: Simmer an additional 15 minutes
  parent add-chicken  # Add chicken

node turn-off-heat: Turn off heat
  parent simmer-an-additional  # Simmer an additional 15 minutes

node slow-stir-gumbo-file: Slow stir in 1 TBSP gumbo file
  parent turn-off-heat  # Turn off heat

node serve-over-steamed-rice: Serve over steamed rice
  parent prepare-rice-cooker-press-start  # Prepare rice in rice cooker and press start
  parent slow-stir-gumbo-file  # Slow stir in 1 TBSP gumbo file

node add-cayenne-spice-bowl: Add 1 tsp cayenne to spice bowl
  parent drain-2-cans-total-diced-canned-tomatoes-give  # Drain 2 cans (28 oz total) diced canned tomatoes

node add-salt-spice-bowl: Add 1 tsp salt to spice bowl
  parent drain-2-cans-total-diced-canned-tomatoes-give  # Drain 2 cans (28 oz total) diced canned tomatoes

node add-basil-spice-bowl: Add 1 tsp basil to spice bowl
  parent drain-2-cans-total-diced-canned-tomatoes-give  # Drain 2 cans (28 oz total) diced canned tomatoes

node add-black-pepper-spice-bowl: Add 1/2 tsp black pepper to spice bowl
  parent drain-2-cans-total-diced-canned-tomatoes-give  # Drain 2 cans (28 oz total) diced canned tomatoes

node add-thyme-spice-bowl: Add 1 tsp thyme to spice bowl
  parent drain-2-cans-total-diced-canned-tomatoes-give  # Drain 2 cans (28 oz total) diced canned tomatoes

node add-one-bay-leaf-spice-bowl: Add one bay leaf to spice bowl
  parent drain-2-cans-total-diced-canned-tomatoes-give  # Drain 2 cans (28 oz total) diced canned tomatoes

node remove-chicken-reserve-water: Remove chicken and RESERVE WATER
  parent simmer-chicken-until-fully-cooked  # Simmer chicken until fully cooked, 20-25 minutes

node shred-cut-chicken-small-pieces-give-curt: Shred or cut chicken into small pieces
  parent remove-chicken-reserve-water  # Remove chicken and RESERVE WATER

node set-spice-bowl-next-gumbo-pot: Set spice bowl next to gumbo pot
  parent add-cayenne-spice-bowl  # Add 1 tsp cayenne to spice bowl
  parent add-salt-spice-bowl  # Add 1 tsp salt to spice bowl
  parent add-basil-spice-bowl  # Add 1 tsp basil to spice bowl
  parent add-black-pepper-spice-bowl  # Add 1/2 tsp black pepper to spice bowl
  parent add-thyme-spice-bowl  # Add 1 tsp thyme to spice bowl
  parent add-one-bay-leaf-spice-bowl  # Add one bay leaf to spice bowl
